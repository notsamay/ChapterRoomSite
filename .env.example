# Copy to .env.local. See README → Waitlist for setup.

# Apps Script web app URL (ends in /exec) from scripts/waitlist-sheet.gs
WAITLIST_WEBHOOK_URL=

# Used for canonical + OG URLs
NEXT_PUBLIC_SITE_URL=https://joinchapterroom.com

# Officer portal (/portal): the app's Supabase project. Use the publishable key (sb_publishable_...),
# never the secret or service_role key. Leave both empty to run the portal on sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
